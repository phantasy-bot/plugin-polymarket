{
  "name": "@phantasy/plugin-polymarket",
  "version": "0.1.2-beta",
  "description": "Polymarket prediction-market integration plugin for Phantasy.",
  "displayName": "Polymarket",
  "author": "Phantasy",
  "homepage": "https://github.com/phantasy-bot/plugin-polymarket",
  "repository": "https://github.com/phantasy-bot/plugin-polymarket",
  "license": "MIT",
  "main": "./dist/index.js",
  "workspace": "business",
  "extensionKind": "integration",
  "category": "markets",
  "tags": [
    "polymarket",
    "prediction-markets",
    "trading",
    "finance"
  ],
  "keywords": [
    "polymarket",
    "prediction-markets",
    "trading",
    "finance"
  ],
  "permissions": [
    "internet"
  ],
  "dependencies": [],
  "platforms": [
    "node"
  ],
  "productionReady": false,
  "adminSurface": {
    "tabId": "polymarket",
    "label": "Polymarket",
    "workspace": "business",
    "kind": "generic",
    "advancedModule": "prediction-markets",
    "keywords": [
      "polymarket",
      "prediction markets",
      "finance"
    ]
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "title": "Enabled"
      },
      "allowTrading": {
        "type": "boolean",
        "default": false,
        "title": "Allow trading",
        "description": "When on, order tools may place CLOB trades. Toggle anytime in this plugin form — no restart required."
      },
      "privateKey": {
        "type": "string",
        "title": "Trading private key",
        "format": "password"
      },
      "funderAddress": {
        "type": "string",
        "title": "Funder address"
      },
      "chainId": {
        "type": "number",
        "default": 137,
        "title": "Chain ID"
      },
      "gammaBaseUrl": {
        "type": "string",
        "default": "https://gamma-api.polymarket.com",
        "title": "Gamma API URL"
      },
      "clobBaseUrl": {
        "type": "string",
        "default": "https://clob.polymarket.com",
        "title": "CLOB API URL"
      }
    }
  },
  "phantasy": {
    "extensions": [
      {
        "path": "./dist/index.js",
        "kind": "tool"
      }
    ],
    "pluginDependencies": [],
    "productionReady": false
  }
}
