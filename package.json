{
  "name": "@phantasy/plugin-polymarket",
  "version": "2.0.1",
  "private": false,
  "description": "Polymarket prediction-market integration plugin for Phantasy.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "phantasy.plugin.json"
  ],
  "sideEffects": false,
  "keywords": [
    "polymarket",
    "prediction-markets",
    "trading",
    "finance"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/phantasy-bot/plugin-polymarket"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/phantasy-bot/plugin-polymarket",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@phantasy/agent": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.2"
  },
  "phantasy": {
    "displayName": "Polymarket",
    "category": "markets",
    "tags": [
      "polymarket",
      "prediction-markets",
      "trading",
      "finance"
    ],
    "workspace": "business",
    "extensionKind": "integration",
    "permissions": [
      "internet"
    ],
    "pluginDependencies": [
      {
        "plugin": "@phantasy/plugin-wallet"
      }
    ],
    "platforms": [
      "node"
    ],
    "productionReady": false,
    "adminSurface": {
      "tabId": "polymarket",
      "label": "Polymarket",
      "section": "business",
      "workspace": "business",
      "kind": "generic",
      "keywords": [
        "polymarket",
        "prediction-markets",
        "trading",
        "finance"
      ]
    },
    "configSchema": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
