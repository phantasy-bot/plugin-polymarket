{
  "name": "@phantasy/plugin-polymarket",
  "version": "0.1.1-beta",
  "private": false,
  "description": "Polymarket prediction-market integration plugin for Phantasy.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "phantasy.plugin.json"
  ],
  "sideEffects": false,
  "keywords": [
    "phantasy",
    "plugin",
    "polymarket",
    "prediction-markets",
    "trading",
    "finance"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/phantasy-bot/plugin-polymarket"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/phantasy-bot/plugin-polymarket",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@phantasy/agent": "^0.1.0-beta"
  },
  "peerDependenciesMeta": {
    "@phantasy/agent": {
      "optional": true
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "phantasy": {
    "displayName": "Polymarket",
    "category": "markets",
    "tags": [
      "polymarket",
      "prediction-markets",
      "trading",
      "finance"
    ],
    "workspace": "business",
    "extensionKind": "integration",
    "permissions": [
      "internet"
    ],
    "pluginDependencies": [],
    "platforms": [
      "node"
    ],
    "productionReady": true,
    "adminSurface": {
      "tabId": "polymarket",
      "label": "Polymarket",
      "workspace": "business",
      "kind": "generic",
      "advancedModule": "prediction-markets",
      "keywords": [
        "polymarket",
        "prediction markets",
        "finance"
      ]
    },
    "configSchema": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "title": "Enabled"
        },
        "allowTrading": {
          "type": "boolean",
          "default": false,
          "title": "Allow trading",
          "description": "When on, order tools may place CLOB trades. Toggle anytime in this plugin form — no restart required."
        },
        "privateKey": {
          "type": "string",
          "title": "Trading private key",
          "format": "password"
        },
        "funderAddress": {
          "type": "string",
          "title": "Funder address"
        },
        "chainId": {
          "type": "number",
          "default": 137,
          "title": "Chain ID"
        },
        "gammaBaseUrl": {
          "type": "string",
          "default": "https://gamma-api.polymarket.com",
          "title": "Gamma API URL"
        },
        "clobBaseUrl": {
          "type": "string",
          "default": "https://clob.polymarket.com",
          "title": "CLOB API URL"
        }
      }
    }
  }
}
